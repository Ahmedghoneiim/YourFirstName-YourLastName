<div class="custom-product-grid-section">
  <h2 class="section-title">Tisso vison in the wild</h2>
  <div class="product-grid-container">
    {% for block in section.blocks %}
      {% assign product = block.settings.product %}
      <div class="grid-product-card" {{ block.shopify_attributes }}>
        {% if product != blank %}
          <div class="product-image-wrapper">
            <img src="{{ product.featured_image | image_url: width: 800 }}" alt="{{ product.title | escape }}" loading="lazy">
            <button type="button" class="quick-view-btn" data-handle="{{ product.handle }}">+</button>
          </div>
        {% else %}
          <div class="product-image-wrapper placeholder">
            <p>Select product</p>
          </div>
        {% endif %}
      </div>
    {% endfor %}
  </div>
</div>

<div id="quick-view-modal" class="qv-modal-overlay" style="display: none;">
  <div class="qv-modal-card">
    <button type="button" class="qv-close-btn">&times;</button>
    <div id="qv-modal-content">
      <p style="text-align:center;">Loading product details...</p>
    </div>
  </div>
</div>

<style>
  .custom-product-grid-section { max-width: 1200px; margin: 40px auto; padding: 0 20px; font-family: sans-serif; }
  .section-title { font-size: 26px; margin-bottom: 25px; font-weight: normal; color: #111; }
  .product-grid-container { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
  .grid-product-card { position: relative; }
  .product-image-wrapper { position: relative; width: 100%; padding-top: 100%; overflow: hidden; }
  .product-image-wrapper img { position: absolute; top: 0; left: 0; width: 100%; height: 100%; object-fit: cover; }
  
  .quick-view-btn {
    position: absolute; bottom: 15px; right: 15px;
    width: 32px; height: 32px; border-radius: 50%;
    background: #000; color: #fff; border: none;
    cursor: pointer; font-size: 20px; z-index: 5;
    display: flex; align-items: center; justify-content: center;
  }

  /* Modal Styling matching design */
  .qv-modal-overlay {
    position: fixed; top: 0; left: 0; width: 100vw; height: 100vh;
    background: rgba(0,0,0,0.4); z-index: 999999;
    display: flex; align-items: center; justify-content: center;
  }
  .qv-modal-card {
    background: #fff; width: 90%; max-width: 440px; padding: 20px;
    position: relative; border-radius: 0px; box-shadow: 0 4px 25px rgba(0,0,0,0.15);
  }
  .qv-close-btn {
    position: absolute; top: 10px; right: 12px; background: none;
    border: none; font-size: 18px; cursor: pointer; color: #333; z-index: 10;
  }

  .qv-body-grid { display: flex; gap: 15px; }
  .qv-img-col { width: 42%; }
  .qv-img-col img { width: 100%; height: auto; display: block; object-fit: cover; }
  .qv-details-col { width: 58%; display: flex; flex-direction: column; justify-content: space-between; }
  
  .qv-title { font-size: 14px; margin: 0 0 4px 0; font-weight: normal; color: #222; }
  .qv-price { font-size: 13px; color: #222; margin-bottom: 8px; font-weight: bold; }
  .qv-desc { font-size: 10px; color: #666; margin-bottom: 12px; line-height: 1.35; }
  
  .qv-label { font-size: 10px; text-transform: capitalize; color: #555; display: block; margin-top: 6px; margin-bottom: 4px; }
  
  /* Color Swatches Grid */
  .qv-swatch-wrapper { display: flex; border: 1px solid #111; margin-bottom: 10px; }
  .qv-swatch-btn {
    flex: 1; padding: 6px 0; background: #fff; border: none; font-size: 11px;
    cursor: pointer; text-align: center; color: #111; border-right: 1px solid #111;
    transition: all 0.2s ease;
  }
  .qv-swatch-btn:last-child { border-right: none; }
  .qv-swatch-btn.active { background: #000; color: #fff; font-weight: bold; }

  /* Dropdown Select */
  .qv-size-select {
    width: 100%; padding: 7px 10px; border: 1px solid #111;
    font-size: 11px; background: #fff; margin-bottom: 12px; cursor: pointer;
    border-radius: 0; outline: none;
  }
  
  .qv-add-btn {
    width: 100%; padding: 10px 15px; background: #000; color: #fff;
    border: none; cursor: pointer; font-weight: bold; font-size: 11px;
    display: flex; justify-content: space-between; align-items: center;
    letter-spacing: 0.5px; margin-top: 5px;
  }

  @media (max-width: 550px) {
    .qv-body-grid { flex-direction: column; }
    .qv-img-col, .qv-details-col { width: 100%; }
    .product-grid-container { grid-template-columns: repeat(2, 1fr); }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const modal = document.getElementById('quick-view-modal');
    const modalContent = document.getElementById('qv-modal-content');
    const closeBtn = document.querySelector('.qv-close-btn');

    closeBtn.addEventListener('click', function() { modal.style.display = 'none'; });
    modal.addEventListener('click', function(e) { if (e.target === modal) modal.style.display = 'none'; });

    document.querySelectorAll('.quick-view-btn').forEach(btn => {
      btn.addEventListener('click', function(e) {
        e.preventDefault();
        e.stopPropagation();
        
        const handle = this.getAttribute('data-handle');
        if (!handle) return;

        modal.style.display = 'flex';
        modalContent.innerHTML = '<p style="text-align:center;">Loading product details...</p>';

        fetch('/products/' + handle + '.js')
          .then(res => res.json())
          .then(product => renderModalData(product))
          .catch(() => {
            modalContent.innerHTML = '<p style="text-align:center; color:red;">Failed to load product.</p>';
          });
      });
    });

    function renderModalData(product) {
      let selectedColor = '';
      let selectedSize = '';

      const colorOpt = product.options.find(o => o.name.toLowerCase().includes('color'));
      const sizeOpt = product.options.find(o => o.name.toLowerCase().includes('size'));

      let colorHTML = '';
      if (colorOpt) {
        selectedColor = colorOpt.values[0];
        colorHTML += `<label class="qv-label">${colorOpt.name}</label><div class="qv-swatch-wrapper">`;
        colorOpt.values.forEach((val, idx) => {
          colorHTML += `<button type="button" class="qv-swatch-btn ${idx === 0 ? 'active' : ''}" data-value="${val}">${val}</button>`;
        });
        colorHTML += `</div>`;
      }

      let sizeHTML = '';
      if (sizeOpt) {
        sizeHTML += `<label class="qv-label">${sizeOpt.name}</label>`;
        sizeHTML += `<select class="qv-size-select" id="qv-size-select-box">`;
        sizeHTML += `<option value="" disabled selected>Choose your size</option>`;
        sizeOpt.values.forEach(val => {
          sizeHTML += `<option value="${val}">${val}</option>`;
        });
        sizeHTML += `</select>`;
      }

      const imgSrc = product.featured_image ? product.featured_image : '';

      modalContent.innerHTML = `
        <div class="qv-body-grid">
          <div class="qv-img-col">
            <img src="${imgSrc}" alt="${product.title}">
          </div>
          <div class="qv-details-col">
            <div>
              <h3 class="qv-title">${product.title}</h3>
              <p class="qv-price">${(product.price / 100).toFixed(2)}€</p>
              <div class="qv-desc">${product.description ? product.description.replace(/<[^>]*>?/gm, '').substring(0, 75) + '...' : ''}</div>
            </div>
            <form id="qv-add-form">
              ${colorHTML}
              ${sizeHTML}
              <button type="submit" class="qv-add-btn">
                <span>ADD TO CART</span>
                <span>&rarr;</span>
              </button>
            </form>
          </div>
        </div>
      `;

      // Swatch Click Logic
      document.querySelectorAll('.qv-swatch-btn').forEach(btn => {
        btn.addEventListener('click', function() {
          document.querySelectorAll('.qv-swatch-btn').forEach(b => b.classList.remove('active'));
          this.classList.add('active');
          selectedColor = this.getAttribute('data-value');
        });
      });

      // Dropdown Logic
      const sizeSelect = document.getElementById('qv-size-select-box');
      if (sizeSelect) {
        sizeSelect.addEventListener('change', function() {
          selectedSize = this.value;
        });
      }

      document.getElementById('qv-add-form').addEventListener('submit', function(e) {
        e.preventDefault();

        let matchedVariant = product.variants.find(v => {
          const opts = v.options.map(o => o.toLowerCase());
          const hasColor = selectedColor ? opts.includes(selectedColor.toLowerCase()) : true;
          const hasSize = selectedSize ? opts.includes(selectedSize.toLowerCase()) : true;
          return hasColor && hasSize;
        });

        if (!matchedVariant) matchedVariant = product.variants[0];

        const isBlack = selectedColor.toLowerCase() === 'black';
        const isMedium = selectedSize.toLowerCase() === 'medium' || selectedSize.toLowerCase() === 'm';

        let itemsToAdd = [{ id: matchedVariant.id, quantity: 1 }];

        if (isBlack && isMedium) {
          fetch('/products/dark-winter-jacket.js')
            .then(res => res.json())
            .then(jacketProduct => {
              if (jacketProduct && jacketProduct.variants && jacketProduct.variants[0]) {
                itemsToAdd.push({ id: jacketProduct.variants[0].id, quantity: 1 });
              }
              postCartItems(itemsToAdd);
            })
            .catch(() => postCartItems(itemsToAdd));
        } else {
          postCartItems(itemsToAdd);
        }
      });
    }

    function postCartItems(items) {
      fetch('/cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ items: items })
      })
      .then(res => res.json())
      .then(() => {
        modal.style.display = 'none';
        window.location.href = '/cart';
      });
    }
  });
</script>

{% schema %}
{
  "name": "Custom Product Grid",
  "settings": [],
  "blocks": [
    {
      "type": "product_block",
      "name": "Product",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Select Product"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Custom Product Grid",
      "blocks": [
        { "type": "product_block" },
        { "type": "product_block" },
        { "type": "product_block" }
      ]
    }
  ]
}
{% endschema %}