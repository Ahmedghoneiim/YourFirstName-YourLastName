<div class="custom-product-grid-section">
  <h2 class="section-title">Tisso vison in the wild</h2>
  <div class="product-grid-container">
    {% for block in section.blocks %}
      {% assign product = block.settings.product %}
      <div class="grid-product-card" {{ block.shopify_attributes }}>
        {% if product != blank %}
          <div class="product-image-wrapper">
            <img src="{{ product.featured_image | image_url: width: 800 }}" alt="{{ product.title | escape }}" loading="lazy">
            <button type="button" class="quick-view-btn" data-handle="{{ product.handle }}">+</button>
          </div>
        {% else %}
          <div class="product-image-wrapper placeholder">
            <p>Select product</p>
          </div>
        {% endif %}
      </div>
    {% endfor %}
  </div>
</div>

<div id="quick-view-modal" class="qv-modal-overlay" style="display: none;">
  <div class="qv-modal-card">
    <button type="button" class="qv-close-btn">&times;</button>
    <div id="qv-modal-content">
      <p style="text-align:center;">Loading product details...</p>
    </div>
  </div>
</div>

{% assign bonus_jacket = section.settings.bonus_product %}

<style>
  .custom-product-grid-section { max-width: 1200px; margin: 40px auto; padding: 0 20px; font-family: inherit; }
  .section-title { font-size: 24px; margin-bottom: 20px; font-weight: normal; }
  .product-grid-container { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
  .grid-product-card { position: relative; }
  .product-image-wrapper { position: relative; width: 100%; padding-top: 100%; overflow: hidden; }
  .product-image-wrapper img { position: absolute; top: 0; left: 0; width: 100%; height: 100%; object-fit: cover; }
  
  .quick-view-btn {
    position: absolute; bottom: 15px; right: 15px;
    width: 32px; height: 32px; border-radius: 50%;
    background: #000; color: #fff; border: none;
    cursor: pointer; font-size: 20px; z-index: 5;
    display: flex; align-items: center; justify-content: center;
  }

  .qv-modal-overlay {
    position: fixed; top: 0; left: 0; width: 100vw; height: 100vh;
    background: rgba(0,0,0,0.4); z-index: 999999;
    display: flex; align-items: center; justify-content: center;
  }
  .qv-modal-card {
    background: #fff; width: 90%; max-width: 500px; padding: 25px;
    position: relative; border-radius: 0px; box-shadow: 0 4px 20px rgba(0,0,0,0.15);
  }
  .qv-close-btn {
    position: absolute; top: 12px; right: 15px; background: none;
    border: none; font-size: 20px; cursor: pointer; color: #000; z-index: 10;
  }

  .qv-body-grid { display: flex; gap: 20px; }
  .qv-img-col { width: 45%; }
  .qv-img-col img { width: 100%; height: auto; display: block; object-fit: cover; }
  .qv-details-col { width: 55%; display: flex; flex-direction: column; }
  
  .qv-title { font-size: 16px; margin: 0 0 8px 0; font-weight: normal; color: #111; }
  .qv-price { font-size: 14px; color: #111; margin-bottom: 12px; font-weight: bold; }
  .qv-desc { font-size: 11px; color: #666; margin-bottom: 15px; line-height: 1.4; }
  
  .qv-label { font-size: 10px; text-transform: uppercase; letter-spacing: 0.5px; color: #777; display: block; margin-top: 10px; margin-bottom: 6px; }
  
  .color-swatches-container { display: flex; border: 1px solid #ccc; margin-bottom: 12px; }
  .color-swatch-btn {
    flex: 1; padding: 8px 0; background: #fff; border: none; font-size: 12px; cursor: pointer;
    text-align: center; border-right: 1px solid #ccc; color: #333;
  }
  .color-swatch-btn:last-child { border-right: none; }
  .color-swatch-btn.active { background: #000; color: #fff; font-weight: bold; }

  .qv-size-select { width: 100%; padding: 10px; border: 1px solid #ccc; font-size: 12px; background: #fff; margin-bottom: 15px; cursor: pointer; }
  
  .qv-add-btn {
    width: 100%; padding: 12px; background: #000; color: #fff;
    border: none; cursor: pointer; font-weight: bold; font-size: 11px;
    display: flex; justify-content: space-between; align-items: center;
    letter-spacing: 1px; margin-top: auto;
  }

  @media (max-width: 550px) {
    .qv-body-grid { flex-direction: column; }
    .qv-img-col, .qv-details-col { width: 100%; }
    .product-grid-container { grid-template-columns: repeat(2, 1fr); }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const bonusJacketVariantId = "{% if bonus_jacket != blank %}{{ bonus_jacket.selected_or_first_available_variant.id }}{% endif %}";
    const bonusJacketHandle = "{% if bonus_jacket != blank %}{{ bonus_jacket.handle }}{% endif %}";

    const modal = document.getElementById('quick-view-modal');
    const modalContent = document.getElementById('qv-modal-content');
    const closeBtn = document.querySelector('.qv-close-btn');

    closeBtn.addEventListener('click', function() { modal.style.display = 'none'; });
    modal.addEventListener('click', function(e) { if (e.target === modal) modal.style.display = 'none'; });

    document.querySelectorAll('.quick-view-btn').forEach(btn => {
      btn.addEventListener('click', function(e) {
        e.preventDefault();
        e.stopPropagation();
        
        const handle = this.getAttribute('data-handle');
        if (!handle) return;

        modal.style.display = 'flex';
        modalContent.innerHTML = '<p style="text-align:center;">Loading product details...</p>';

        fetch('/products/' + handle + '.js')
          .then(res => res.json())
          .then(product => renderModalData(product))
          .catch(() => {
            modalContent.innerHTML = '<p style="text-align:center; color:red;">Failed to load product.</p>';
          });
      });
    });

    function renderModalData(product) {
      let selectedColor = '';
      let selectedSize = '';

      const colorOption = product.options.find(o => o.name.toLowerCase().includes('color'));
      const sizeOption = product.options.find(o => o.name.toLowerCase().includes('size'));

      let colorsHTML = '';
      if (colorOption) {
        selectedColor = colorOption.values[0];
        colorsHTML += '<div class="color-swatches-container">';
        colorOption.values.forEach((val, idx) => {
          colorsHTML += `<button type="button" class="color-swatch-btn ${idx === 0 ? 'active' : ''}" data-value="${val}">${val}</button>`;
        });
        colorsHTML += '</div>';
      }

      let sizesHTML = '';
      if (sizeOption) {
        selectedSize = sizeOption.values[0];
        sizesHTML += '<select class="qv-size-select" id="qv-size-dropdown">';
        sizeOption.values.forEach(val => {
          sizesHTML += `<option value="${val}">${val}</option>`;
        });
        sizesHTML += '</select>';
      }

      const imgSrc = product.featured_image ? product.featured_image : '';

      modalContent.innerHTML = `
        <div class="qv-body-grid">
          <div class="qv-img-col">
            <img src="${imgSrc}" alt="${product.title}">
          </div>
          <div class="qv-details-col">
            <h3 class="qv-title">${product.title}</h3>
            <p class="qv-price">$${(product.price / 100).toFixed(2)}</p>
            <div class="qv-desc">${product.description ? product.description.replace(/<[^>]*>?/gm, '').substring(0, 85) + '...' : ''}</div>
            <form id="qv-add-form">
              ${colorOption ? `<label class="qv-label">COLOR</label>${colorsHTML}` : ''}
              ${sizeOption ? `<label class="qv-label">SIZE</label>${sizesHTML}` : ''}
              <button type="submit" class="qv-add-btn">
                <span>ADD TO CART</span>
                <span>&rarr;</span>
              </button>
            </form>
          </div>
        </div>
      `;

      document.querySelectorAll('.color-swatch-btn').forEach(btn => {
        btn.addEventListener('click', function() {
          document.querySelectorAll('.color-swatch-btn').forEach(b => b.classList.remove('active'));
          this.classList.add('active');
          selectedColor = this.getAttribute('data-value');
        });
      });

      const sizeDropdown = document.getElementById('qv-size-dropdown');
      if (sizeDropdown) {
        sizeDropdown.addEventListener('change', function() {
          selectedSize = this.value;
        });
      }

      document.getElementById('qv-add-form').addEventListener('submit', function(e) {
        e.preventDefault();

        let matchedVariant = product.variants.find(v => {
          const opts = v.options.map(o => o.toLowerCase());
          const hasColor = selectedColor ? opts.includes(selectedColor.toLowerCase()) : true;
          const hasSize = selectedSize ? opts.includes(selectedSize.toLowerCase()) : true;
          return hasColor && hasSize;
        });

        if (!matchedVariant) matchedVariant = product.variants[0];

        const isBlack = selectedColor.toLowerCase() === 'black';
        const isMedium = selectedSize.toLowerCase() === 'medium' || selectedSize.toLowerCase() === 'm';

        let itemsToAdd = [{ id: matchedVariant.id, quantity: 1 }];

        if (isBlack && isMedium) {
          if (bonusJacketVariantId) {
            itemsToAdd.push({ id: parseInt(bonusJacketVariantId), quantity: 1 });
            postCartItems(itemsToAdd);
          } else {
            // Fallback search if setting is empty
            fetch('/search.js?q=Soft+Winter+Jacket&type=product')
              .then(r => r.json())
              .then(searchData => {
                 if (searchData.results && searchData.results.length > 0) {
                    fetch('/products/' + searchData.results[0].handle + '.js')
                      .then(res => res.json())
                      .then(j => {
                        itemsToAdd.push({ id: j.variants[0].id, quantity: 1 });
                        postCartItems(itemsToAdd);
                      });
                 } else {
                    postCartItems(itemsToAdd);
                 }
              }).catch(() => postCartItems(itemsToAdd));
          }
        } else {
          postCartItems(itemsToAdd);
        }
      });
    }

    function postCartItems(items) {
      fetch('/cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ items: items })
      })
      .then(res => res.json())
      .then(() => {
        modal.style.display = 'none';
        window.location.href = '/cart';
      });
    }
  });
</script>

{% schema %}
{
  "name": "Custom Product Grid",
  "settings": [
    {
      "type": "product",
      "id": "bonus_product",
      "label": "Auto-Add Bonus Product (Soft Winter Jacket)"
    }
  ],
  "blocks": [
    {
      "type": "product_block",
      "name": "Product",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Select Product"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Custom Product Grid",
      "blocks": [
        { "type": "product_block" },
        { "type": "product_block" },
        { "type": "product_block" }
      ]
    }
  ]
}
{% endschema %}