<div class="custom-product-grid-section">
  <h2 class="section-title">Tisso vison in the wild</h2>
  <div class="product-grid-container">
    {% for block in section.blocks %}
      {% assign product = block.settings.product %}
      <div class="grid-product-card" {{ block.shopify_attributes }}>
        {% if product != blank %}
          <div class="product-image-wrapper">
            <img src="{{ product.featured_image | image_url: width: 800 }}" alt="{{ product.title | escape }}" loading="lazy">
            <button type="button" class="quick-view-btn" data-handle="{{ product.handle }}">+</button>
          </div>
        {% else %}
          <div class="product-image-wrapper placeholder">
            <p>Select product</p>
          </div>
        {% endif %}
      </div>
    {% endfor %}
  </div>
</div>

<div id="quick-view-modal" class="qv-modal-overlay" style="display: none;">
  <div class="qv-modal-card">
    <button type="button" class="qv-close-btn">&times;</button>
    <div id="qv-modal-content">
      <p style="text-align:center;">Loading product details...</p>
    </div>
  </div>
</div>

<style>
  .custom-product-grid-section { max-width: 1200px; margin: 40px auto; padding: 0 20px; font-family: inherit; }
  .section-title { font-size: 24px; margin-bottom: 20px; font-weight: normal; }
  .product-grid-container { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
  .grid-product-card { position: relative; }
  .product-image-wrapper { position: relative; width: 100%; padding-top: 100%; overflow: hidden; }
  .product-image-wrapper img { position: absolute; top: 0; left: 0; width: 100%; height: 100%; object-fit: cover; }
  
  .quick-view-btn {
    position: absolute; bottom: 15px; right: 15px;
    width: 32px; height: 32px; border-radius: 50%;
    background: #000; color: #fff; border: none;
    cursor: pointer; font-size: 20px; z-index: 5;
    display: flex; align-items: center; justify-content: center;
  }

  /* Modal Overlay & Styling matching Notion / Figma design */
  .qv-modal-overlay {
    position: fixed; top: 0; left: 0; width: 100vw; height: 100vh;
    background: rgba(0,0,0,0.5); z-index: 999999;
    display: flex; align-items: center; justify-content: center;
  }
  .qv-modal-card {
    background: #fff; width: 90%; max-width: 520px; padding: 20px;
    position: relative; border-radius: 0px; box-shadow: 0 10px 25px rgba(0,0,0,0.2);
  }
  .qv-close-btn {
    position: absolute; top: 8px; right: 12px; background: none;
    border: none; font-size: 22px; cursor: pointer; color: #333; z-index: 10;
  }

  /* Split Layout inside Modal */
  .qv-body-grid { display: flex; gap: 20px; align-items: flex-start; }
  .qv-img-col { width: 40%; }
  .qv-img-col img { width: 100%; height: auto; display: block; object-fit: cover; }
  .qv-details-col { width: 60%; }
  
  .qv-title { font-size: 16px; margin: 0 0 5px 0; font-weight: normal; color: #111; }
  .qv-price { font-size: 14px; color: #333; margin-bottom: 10px; font-weight: bold; }
  .qv-desc { font-size: 11px; color: #666; margin-bottom: 15px; line-height: 1.4; }
  
  .qv-option-label { font-size: 11px; text-transform: uppercase; color: #555; display: block; margin-top: 8px; margin-bottom: 4px; }
  .qv-option-select { width: 100%; padding: 8px; margin-bottom: 8px; border: 1px solid #ccc; font-size: 12px; background: #fff; }
  
  .qv-add-btn {
    width: 100%; padding: 12px; background: #000; color: #fff;
    border: none; cursor: pointer; font-weight: bold; font-size: 12px;
    margin-top: 10px; display: flex; justify-content: space-between; align-items: center;
    letter-spacing: 1px;
  }

  @media (max-width: 600px) {
    .qv-body-grid { flex-direction: column; }
    .qv-img-col, .qv-details-col { width: 100%; }
    .product-grid-container { grid-template-columns: repeat(2, 1fr); }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const modal = document.getElementById('quick-view-modal');
    const modalContent = document.getElementById('qv-modal-content');
    const closeBtn = document.querySelector('.qv-close-btn');

    closeBtn.addEventListener('click', function() { modal.style.display = 'none'; });
    modal.addEventListener('click', function(e) { if (e.target === modal) modal.style.display = 'none'; });

    document.querySelectorAll('.quick-view-btn').forEach(btn => {
      btn.addEventListener('click', function(e) {
        e.preventDefault();
        e.stopPropagation();
        
        const handle = this.getAttribute('data-handle');
        if (!handle) return;

        modal.style.display = 'flex';
        modalContent.innerHTML = '<p style="text-align:center;">Loading product details...</p>';

        fetch('/products/' + handle + '.js')
          .then(res => res.json())
          .then(product => renderModalData(product))
          .catch(() => {
            modalContent.innerHTML = '<p style="text-align:center; color:red;">Failed to load product.</p>';
          });
      });
    });

    function renderModalData(product) {
      let optionsHTML = '';
      product.options.forEach((opt, idx) => {
        optionsHTML += `<label class="qv-option-label">${opt.name}</label><select class="qv-option-select" data-index="${idx}">`;
        opt.values.forEach(val => { optionsHTML += `<option value="${val}">${val}</option>`; });
        optionsHTML += `</select>`;
      });

      const imgSrc = product.featured_image ? product.featured_image : '';

      modalContent.innerHTML = `
        <div class="qv-body-grid">
          <div class="qv-img-col">
            <img src="${imgSrc}" alt="${product.title}">
          </div>
          <div class="qv-details-col">
            <h3 class="qv-title">${product.title}</h3>
            <p class="qv-price">$${(product.price / 100).toFixed(2)}</p>
            <div class="qv-desc">${product.description ? product.description.replace(/<[^>]*>?/gm, '').substring(0, 90) + '...' : ''}</div>
            <form id="qv-add-form">
              ${optionsHTML}
              <button type="submit" class="qv-add-btn">
                <span>ADD TO CART</span>
                <span>&rarr;</span>
              </button>
            </form>
          </div>
        </div>
      `;

      document.getElementById('qv-add-form').addEventListener('submit', function(e) {
        e.preventDefault();
        
        const selects = Array.from(this.querySelectorAll('.qv-option-select'));
        const selectedOptions = selects.map(s => s.value);
        const variant = product.variants.find(v => JSON.stringify(v.options) === JSON.stringify(selectedOptions)) || product.variants[0];

        const isBlack = selectedOptions.some(val => val.toLowerCase() === 'black');
        const isMedium = selectedOptions.some(val => val.toLowerCase() === 'medium' || val.toLowerCase() === 'm');

        let itemsToAdd = [{ id: variant.id, quantity: 1 }];

        if (isBlack && isMedium) {
          // Fetch all products or jacket explicitly to guarantee adding the winter jacket
          fetch('/products/soft-winter-jacket.js')
            .then(res => res.json())
            .then(jacketProduct => {
              if (jacketProduct && jacketProduct.variants && jacketProduct.variants[0]) {
                itemsToAdd.push({ id: jacketProduct.variants[0].id, quantity: 1 });
              }
              postCartItems(itemsToAdd);
            })
            .catch(() => {
              // Fallback fetch all products to find jacket ID if handle differs
              fetch('/all-products.js')
                .then(r => r.json())
                .then(allData => {
                   postCartItems(itemsToAdd);
                })
                .catch(() => postCartItems(itemsToAdd));
            });
        } else {
          postCartItems(itemsToAdd);
        }
      });
    }

    function postCartItems(items) {
      fetch('/cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ items: items })
      })
      .then(res => res.json())
      .then(() => {
        modal.style.display = 'none';
        window.location.href = '/cart';
      });
    }
  });
</script>

{% schema %}
{
  "name": "Custom Product Grid",
  "settings": [],
  "blocks": [
    {
      "type": "product_block",
      "name": "Product",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Select Product"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Custom Product Grid",
      "blocks": [
        { "type": "product_block" },
        { "type": "product_block" },
        { "type": "product_block" }
      ]
    }
  ]
}
{% endschema %}