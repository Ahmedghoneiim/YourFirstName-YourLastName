<div class="custom-product-grid-section">
  <h2 class="section-title">Tisso vison in the wild</h2>
  <div class="product-grid-container">
    {% for block in section.blocks %}
      {% assign product = block.settings.product %}
      <div class="grid-product-card" {{ block.shopify_attributes }}>
        {% if product != blank %}
          <div class="product-image-wrapper">
            <img src="{{ product.featured_image | image_url: width: 800 }}" alt="{{ product.title | escape }}" loading="lazy">
            <button type="button" class="quick-view-btn" data-handle="{{ product.handle }}">+</button>
          </div>
        {% else %}
          <div class="product-image-wrapper placeholder">
            <p>Select product</p>
          </div>
        {% endif %}
      </div>
    {% endfor %}
  </div>
</div>

<div id="quick-view-modal" class="qv-modal-overlay" style="display: none;">
  <div class="qv-modal-card">
    <button type="button" class="qv-close-btn">&times;</button>
    <div id="qv-modal-content">
      <p style="text-align:center;">Loading product details...</p>
    </div>
  </div>
</div>

<style>
  .custom-product-grid-section { max-width: 1200px; margin: 40px auto; padding: 0 20px; font-family: sans-serif; }
  .section-title { font-size: 26px; margin-bottom: 25px; font-weight: normal; color: #111; }
  .product-grid-container { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
  .grid-product-card { position: relative; }
  .product-image-wrapper { position: relative; width: 100%; padding-top: 100%; overflow: hidden; }
  .product-image-wrapper img { position: absolute; top: 0; left: 0; width: 100%; height: 100%; object-fit: cover; }

  .quick-view-btn {
    position: absolute; bottom: 15px; right: 15px;
    width: 32px; height: 32px; border-radius: 50%;
    background: #000; color: #fff; border: none;
    cursor: pointer; font-size: 20px; z-index: 5;
    display: flex; align-items: center; justify-content: center;
  }

  /* Modal Base Styling */
  .qv-modal-overlay {
    position: fixed; top: 0; left: 0; width: 100vw; height: 100vh;
    background: rgba(0,0,0,0.4); z-index: 999999;
    display: flex; align-items: center; justify-content: center;
  }
  .qv-modal-card {
    background: #fff; width: 90%; max-width: 360px; padding: 20px;
    position: relative; border-radius: 0px; box-shadow: 0 4px 25px rgba(0,0,0,0.15);
  }
  .qv-close-btn {
    position: absolute; top: 10px; right: 12px; background: none;
    border: none; font-size: 18px; cursor: pointer; color: #333; z-index: 10;
  }

  /* Top Section: Image + Info side by side */
  .qv-top-row { display: flex; gap: 15px; margin-bottom: 12px; }
  .qv-img-col { width: 45%; flex-shrink: 0; }
  .qv-img-col img { width: 100%; height: auto; display: block; object-fit: cover; aspect-ratio: 1/1; }
  .qv-details-col { width: 55%; display: flex; flex-direction: column; justify-content: flex-start; }

  .qv-title { font-size: 14px; margin: 0 0 6px 0; font-weight: normal; color: #222; }
  .qv-price { font-size: 13px; color: #222; margin-bottom: 8px; font-weight: bold; }
  .qv-desc { font-size: 10px; color: #666; line-height: 1.35; margin: 0; }

  /* Full Width Form Elements below top row */
  .qv-form-full { width: 100%; }
  .qv-label { font-size: 11px; text-transform: capitalize; color: #555; display: block; margin-top: 10px; margin-bottom: 6px; }

  /* Color Swatches - Full Width Box */
  .qv-swatch-wrapper { display: flex; border: 1px solid #000000; width: 100%; margin-bottom: 10px; }
  .qv-swatch-btn {
    flex: 1; min-width: 0; padding: 8px 6px 8px 11px; background: #fff; border: none;
    font-size: 11px; cursor: pointer; text-align: center; color: #111;
    border-right: 2px solid #000000; transition: all 0.2s ease; position: relative;
    display: flex; align-items: center; justify-content: center; box-sizing: border-box;
  }
  .qv-swatch-btn:last-child { border-right: none; }
  .qv-swatch-btn.active { background: #000; color: #fff; font-weight: bold; }
  .qv-swatch-btn::before {
    content: ""; position: absolute; top: 0; left: 0; width: 5px; height: 100%;
    background-color: var(--swatch-color, #000000);
  }

  /* Size Dropdown - Full Width */
  .qv-size-select {
    width: 100%; padding: 8px 10px; border: 1px solid #111;
    font-size: 11px; background: #fff; margin-bottom: 15px; cursor: pointer;
    border-radius: 0; outline: none; box-sizing: border-box;
  }

  /* Add To Cart Button - Full Width */
  .qv-add-btn {
    width: 100%; padding: 11px 15px; background: #000; color: #fff;
    border: none; cursor: pointer; font-weight: bold; font-size: 11px;
    display: flex; justify-content: space-between; align-items: center;
    letter-spacing: 0.5px; box-sizing: border-box;
  }

  @media (max-width: 480px) {
    .qv-modal-card { width: 92%; padding: 15px; }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const modal = document.getElementById('quick-view-modal');
    const modalContent = document.getElementById('qv-modal-content');
    const closeBtn = document.querySelector('.qv-close-btn');

    closeBtn.addEventListener('click', function() { modal.style.display = 'none'; });
    modal.addEventListener('click', function(e) { if (e.target === modal) modal.style.display = 'none'; });

    document.querySelectorAll('.quick-view-btn').forEach(btn => {
      btn.addEventListener('click', function(e) {
        e.preventDefault();
        e.stopPropagation();

        const handle = this.getAttribute('data-handle');
        if (!handle) return;

        modal.style.display = 'flex';
        modalContent.innerHTML = '<p style="text-align:center;">Loading product details...</p>';

        fetch('/products/' + handle + '.js')
          .then(res => {
            if (!res.ok) throw new Error('Product request failed');
            return res.json();
          })
          .then(product => renderModalData(product))
          .catch(() => {
            modalContent.innerHTML = '<p style="text-align:center; color:red;">Failed to load product.</p>';
          });
      });
    });

    function renderModalData(product) {
      if (!product || !Array.isArray(product.variants) || !product.variants.length) {
        modalContent.innerHTML = '<p style="text-align:center; color:red;">Product variants are unavailable.</p>';
        return;
      }

      const variants = product.variants;
      const options = normalizeProductOptions(product);
      const colorOpt = findColorOption(options);
      const sizeOpt = findSizeOption(options, colorOpt);
      let selectedColor = colorOpt && colorOpt.values.length ? colorOpt.values[0] : '';
      let selectedSize = '';

      let colorHTML = '';
      if (colorOpt && colorOpt.values.length) {
        const colorLabel = colorOpt.name && normalizeText(colorOpt.name) !== 'title' ? colorOpt.name : 'Color';
        colorHTML += `<label class="qv-label">${escapeHTML(colorLabel)}</label><div class="qv-swatch-wrapper">`;
        colorOpt.values.forEach((val, idx) => {
          const displayName = getColorDisplayName(val, product);
          const swatchColor = getSwatchHex(val, product);
          colorHTML += `<button type="button" class="qv-swatch-btn ${idx === 0 ? 'active' : ''}" data-value="${escapeAttribute(val)}" style="--swatch-color: ${swatchColor};">${escapeHTML(displayName)}</button>`;
        });
        colorHTML += '</div>';
      }

      let sizeHTML = '';
      if (sizeOpt && sizeOpt.values.length) {
        const sizeLabel = sizeOpt.name && normalizeText(sizeOpt.name) !== 'title' ? sizeOpt.name : 'Size';
        sizeHTML += `<label class="qv-label">${escapeHTML(sizeLabel)}</label>`;
        sizeHTML += '<select class="qv-size-select" id="qv-size-select-box">';
        sizeHTML += '<option value="" disabled selected>Choose your size</option>';
        sizeOpt.values.forEach(val => {
          sizeHTML += `<option value="${escapeAttribute(val)}">${escapeHTML(val)}</option>`;
        });
        sizeHTML += '</select>';
      }

      const imgSrc = product.featured_image || (Array.isArray(product.images) && product.images[0]) || '';
      const productTitle = product.title || '';
      const productDescription = product.description ? stripHTML(product.description).substring(0, 70) + '...' : '';
      const productPrice = typeof product.price === 'number' ? product.price : variants[0].price;

      modalContent.innerHTML = `
        <div class="qv-top-row">
          <div class="qv-img-col">
            <img src="${escapeAttribute(imgSrc)}" alt="${escapeAttribute(productTitle)}">
          </div>
          <div class="qv-details-col">
            <h3 class="qv-title">${escapeHTML(productTitle)}</h3>
            <p class="qv-price">${((productPrice || 0) / 100).toFixed(2)}&euro;</p>
            <div class="qv-desc">${escapeHTML(productDescription)}</div>
          </div>
        </div>
        <form id="qv-add-form" class="qv-form-full">
          ${colorHTML}
          ${sizeHTML}
          <button type="submit" class="qv-add-btn">
            <span>ADD TO CART</span>
            <span>&rarr;</span>
          </button>
        </form>
      `;

      modalContent.querySelectorAll('.qv-swatch-btn').forEach(btn => {
        btn.addEventListener('click', function() {
          modalContent.querySelectorAll('.qv-swatch-btn').forEach(swatch => swatch.classList.remove('active'));
          this.classList.add('active');
          selectedColor = this.getAttribute('data-value') || '';
        });
      });

      const sizeSelect = document.getElementById('qv-size-select-box');
      if (sizeSelect) {
        sizeSelect.addEventListener('change', function() {
          selectedSize = this.value || '';
        });
      }

      const addForm = document.getElementById('qv-add-form');
      if (!addForm) return;

      addForm.addEventListener('submit', function(e) {
        e.preventDefault();

        let matchedVariant = findMatchingVariant(variants, colorOpt, selectedColor, sizeOpt, selectedSize);
        if (!matchedVariant) matchedVariant = variants.find(variant => variant.available) || variants[0];

        const normalizedSelectedColor = normalizeText(getColorDisplayName(selectedColor, product));
        const normalizedSelectedSize = normalizeText(selectedSize);
        const isBlack = normalizedSelectedColor === 'black';
        const isMedium = normalizedSelectedSize === 'medium' || normalizedSelectedSize === 'm';
        let itemsToAdd = [{ id: matchedVariant.id, quantity: 1 }];

        if (isBlack && isMedium) {
          fetch('/products/dark-winter-jacket.js')
            .then(res => {
              if (!res.ok) throw new Error('Hidden product request failed');
              return res.json();
            })
            .then(jacketProduct => {
              if (jacketProduct && Array.isArray(jacketProduct.variants) && jacketProduct.variants[0]) {
                itemsToAdd.push({ id: jacketProduct.variants[0].id, quantity: 1 });
              }
              postCartItems(itemsToAdd);
            })
            .catch(() => postCartItems(itemsToAdd));
        } else {
          postCartItems(itemsToAdd);
        }
      });
    }

    function normalizeProductOptions(product) {
      const variants = Array.isArray(product.variants) ? product.variants : [];
      const sourceOptions = Array.isArray(product.options) ? product.options : [];
      const normalized = sourceOptions.map((option, idx) => {
        if (typeof option === 'string') {
          return {
            name: option,
            position: idx + 1,
            values: collectOptionValues(variants, idx)
          };
        }

        const position = typeof option.position === 'number' ? option.position : idx + 1;
        const values = Array.isArray(option.values) && option.values.length
          ? option.values.filter(Boolean)
          : collectOptionValues(variants, position - 1);

        return {
          name: option.name || `Option ${position}`,
          position: position,
          values: uniqueValues(values)
        };
      });

      for (let idx = normalized.length; idx < 3; idx++) {
        const values = collectOptionValues(variants, idx);
        if (values.length) {
          normalized.push({
            name: `Option ${idx + 1}`,
            position: idx + 1,
            values: values
          });
        }
      }

      return normalized.filter(option => option.values.length && !(option.values.length === 1 && normalizeText(option.values[0]) === 'default title'));
    }

    function collectOptionValues(variants, optionIndex) {
      if (!Array.isArray(variants)) return [];

      return uniqueValues(variants.map(variant => {
        if (Array.isArray(variant.options) && variant.options[optionIndex]) {
          return variant.options[optionIndex];
        }

        return variant[`option${optionIndex + 1}`];
      }).filter(Boolean));
    }

    function findColorOption(options) {
      const byName = options.find(option => /colou?r|shade|tone|finish/i.test(option.name || ''));
      if (byName) return byName;

      const byValue = options.find(option => option.values.some(value => hasColorToken(value)));
      if (byValue) return byValue;

      return options.find(option => {
        const values = option.values.map(value => normalizeText(value));
        return values.length > 1 && !values.every(isSizeValue);
      }) || null;
    }

    function findSizeOption(options, colorOpt) {
      const byName = options.find(option => option !== colorOpt && /size|taille|talla|grandeur/i.test(option.name || ''));
      if (byName) return byName;

      return options.find(option => option !== colorOpt && option.values.some(value => isSizeValue(normalizeText(value)))) || null;
    }

    function findMatchingVariant(variants, colorOpt, selectedColor, sizeOpt, selectedSize) {
      return variants.find(variant => {
        const colorMatches = !colorOpt || !selectedColor || optionValueMatches(variant, colorOpt.position, selectedColor);
        const sizeMatches = !sizeOpt || !selectedSize || optionValueMatches(variant, sizeOpt.position, selectedSize);
        return colorMatches && sizeMatches;
      });
    }

    function optionValueMatches(variant, position, selectedValue) {
      const variantValue = getVariantOptionValue(variant, position);
      return normalizeText(variantValue) === normalizeText(selectedValue);
    }

    function getVariantOptionValue(variant, position) {
      const idx = position - 1;
      if (Array.isArray(variant.options) && typeof variant.options[idx] !== 'undefined') {
        return variant.options[idx];
      }

      return variant[`option${position}`] || '';
    }

    function getColorDisplayName(value, product) {
      const originalValue = value || '';
      const normalized = normalizeText(originalValue);

      if (normalized === 'white black') return 'Blue/Black';

      if (normalized.includes('blue') && normalized.includes('black')) return 'Blue/Black';
      if (normalized.includes('white') && normalized.includes('black')) return 'Black';
      if (normalized.includes('black')) return 'Black';
      if (normalized.includes('blue')) return 'Blue';
      if (normalized.includes('white')) return 'White';

      return originalValue || 'Color';
    }

    function getSwatchHex(value, product) {
      const colorName = normalizeText(getColorDisplayName(value, product));
      const originalValue = normalizeText(value);

      if (colorName.includes('blue') || originalValue.includes('blue')) return '#0D499F';
      if (colorName.includes('black') || originalValue.includes('black')) return '#000000';
      if (colorName.includes('white') || originalValue.includes('white')) return '#FFFFFF';
      if (colorName.includes('grey') || colorName.includes('gray')) return '#808080';
      if (colorName.includes('red')) return '#C1121F';
      if (colorName.includes('green')) return '#1F7A3A';
      if (colorName.includes('navy')) return '#001F54';
      if (colorName.includes('cream') || colorName.includes('ivory')) return '#F4EBD0';
      if (colorName.includes('beige')) return '#D6C6A8';
      if (colorName.includes('brown')) return '#6F4E37';

      return '#000000';
    }

    function hasColorToken(value) {
      return /(black|white|blue|grey|gray|red|green|navy|cream|ivory|beige|brown)/i.test(value || '');
    }

    function isSizeValue(value) {
      const normalized = normalizeText(value);
      return /^(xxs|xs|s|m|l|xl|xxl|xxxl|small|medium|large|one size|os|\d{1,2})$/.test(normalized);
    }

    function uniqueValues(values) {
      const seen = new Set();
      return values.filter(value => {
        const key = normalizeText(value);
        if (!key || seen.has(key)) return false;
        seen.add(key);
        return true;
      });
    }

    function normalizeText(value) {
      return String(value || '').trim().toLowerCase().replace(/&amp;/g, '&').replace(/[^\w]+/g, ' ').replace(/\s+/g, ' ').trim();
    }

    function stripHTML(value) {
      const temp = document.createElement('div');
      temp.innerHTML = value || '';
      return temp.textContent || temp.innerText || '';
    }

    function escapeHTML(value) {
      return String(value || '').replace(/[&<>"']/g, char => ({
        '&': '&amp;',
        '<': '&lt;',
        '>': '&gt;',
        '"': '&quot;',
        "'": '&#039;'
      })[char]);
    }

    function escapeAttribute(value) {
      return escapeHTML(value).replace(/`/g, '&#096;');
    }

    function postCartItems(items) {
      fetch('/cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ items: items })
      })
      .then(res => res.json())
      .then(() => {
        modal.style.display = 'none';
        window.location.href = '/cart';
      });
    }
  });
</script>

{% schema %}
{
  "name": "Custom Product Grid",
  "settings": [],
  "blocks": [
    {
      "type": "product_block",
      "name": "Product",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Select Product"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Custom Product Grid",
      "blocks": [
        { "type": "product_block" },
        { "type": "product_block" },
        { "type": "product_block" }
      ]
    }
  ]
}
{% endschema %}
