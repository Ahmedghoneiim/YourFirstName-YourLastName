<div class="custom-product-grid-section">
  <h2 class="section-title">Tisso vison in the wild</h2>
  <div class="product-grid-container">
    {% for block in section.blocks %}
      {% assign product = block.settings.product %}
      <div class="grid-product-card" {{ block.shopify_attributes }}>
        {% if product != blank %}
          <div class="product-image-wrapper">
            <img src="{{ product.featured_image | image_url: width: 800 }}" alt="{{ product.title | escape }}" loading="lazy">
            <button type="button" class="quick-view-btn" data-handle="{{ product.handle }}">+</button>
          </div>
        {% else %}
          <div class="product-image-wrapper placeholder">
            <p>Select product</p>
          </div>
        {% endif %}
      </div>
    {% endfor %}
  </div>
</div>

<div id="quick-view-modal" class="qv-modal-overlay" style="display: none;">
  <div class="qv-modal-card">
    <button type="button" class="qv-close-btn">&times;</button>
    <div id="qv-modal-content">
      <p style="text-align:center;">Loading product details...</p>
    </div>
  </div>
</div>

<style>
  /* Base Layout */
  .custom-product-grid-section { max-width: 1200px; margin: 40px auto; padding: 0 20px; font-family: 'Jost', sans-serif; }
  .section-title { font-size: 26px; margin-bottom: 25px; font-weight: normal; color: #111; }
  .product-grid-container { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
  .grid-product-card { position: relative; }
  .product-image-wrapper { position: relative; width: 100%; padding-top: 100%; overflow: hidden; }
  .product-image-wrapper img { position: absolute; top: 0; left: 0; width: 100%; height: 100%; object-fit: cover; }
  
  .quick-view-btn {
    position: absolute; bottom: 15px; right: 15px;
    width: 32px; height: 32px; border-radius: 50%;
    background: #000; color: #fff; border: none;
    cursor: pointer; font-size: 20px; z-index: 5;
    display: flex; align-items: center; justify-content: center;
  }

  /* Modal Style - Pixel-Perfect Matching Figma */
  .qv-modal-overlay {
    position: fixed; top: 0; left: 0; width: 100vw; height: 100vh;
    background: rgba(0,0,0,0.4); z-index: 999999;
    display: flex; align-items: center; justify-content: center;
  }
  .qv-modal-card {
    background: #fff; width: 90%; max-width: 350px; padding: 20px;
    position: relative; border-radius: 0px; box-shadow: 0 4px 25px rgba(0,0,0,0.15);
  }
  .qv-close-btn {
    position: absolute; top: 10px; right: 12px; background: none;
    border: none; font-size: 20px; cursor: pointer; color: #333; z-index: 10;
  }

  .qv-top-row { display: flex; gap: 15px; margin-bottom: 12px; }
  .qv-img-col { width: 42%; flex-shrink: 0; }
  .qv-img-col img { width: 100%; height: auto; display: block; object-fit: cover; aspect-ratio: 1/1; }
  .qv-details-col { width: 58%; display: flex; flex-direction: column; justify-content: flex-start; }
  
  .qv-title { font-size: 15px; margin: 0 0 6px 0; font-weight: 400; color: #222; }
  .qv-price { font-size: 14px; color: #222; margin-bottom: 8px; font-weight: 500; }
  .qv-desc { font-size: 11px; color: #555; line-height: 1.35; margin: 0; }

  .qv-form-full { width: 100%; }
  .qv-label { font-size: 12px; color: #333; display: block; margin-top: 12px; margin-bottom: 6px; }
  
  /* Color Swatches - Component 208 Figma Specs */
  .qv-swatch-wrapper {
    display: flex;
    border: 1px solid #000000;
    width: 100%;
    margin-bottom: 12px;
    box-sizing: border-box;
    background: #ffffff;
  }

  .qv-swatch-btn {
    flex: 1;
    height: 42px;
    background: #ffffff;
    border: none;
    font-family: 'Jost', sans-serif;
    font-size: 14px;
    color: #000000;
    cursor: pointer;
    text-align: left;
    padding-left: 16px;
    position: relative;
    display: flex;
    align-items: center;
    box-sizing: border-box;
  }

  /* الفاصل الأسود في النص */
  .qv-swatch-btn:not(:last-child) {
    border-right: 2px solid #000000;
  }

  /* الشريط العمودي الملون (4.84px width in Figma) */
  .qv-swatch-btn::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 5px;
    background-color: var(--swatch-color, #000000);
  }

  .qv-swatch-btn.active {
    font-weight: 600;
  }

  /* Size Dropdown Box */
  .qv-size-container {
    position: relative;
    width: 100%;
    margin-bottom: 18px;
  }

  .qv-size-select {
    width: 100%;
    height: 42px;
    padding: 0 35px 0 12px;
    border: 1px solid #000000;
    font-size: 13px;
    font-family: 'Jost', sans-serif;
    background: #fff;
    cursor: pointer;
    border-radius: 0;
    outline: none;
    box-sizing: border-box;
    appearance: none;
    -webkit-appearance: none;
  }

  .qv-size-container::after {
    content: '∨';
    position: absolute;
    right: 12px;
    top: 50%;
    transform: translateY(-50%);
    pointer-events: none;
    font-size: 12px;
    font-weight: bold;
    color: #000;
  }
  
  /* Add To Cart Button */
  .qv-add-btn {
    width: 100%; height: 45px; background: #000000; color: #ffffff;
    border: none; outline: none; cursor: pointer;
    font-family: 'Jost', sans-serif;
    font-size: 15px;
    letter-spacing: 0.5px;
    text-transform: uppercase;
    display: flex; justify-content: center; align-items: center; gap: 10px;
  }

  .qv-add-btn .btn-arrow {
    font-size: 20px !important; line-height: 1;
    display: inline-block; font-weight: 300; margin-left: 8px;
  }

  @media (max-width: 480px) {
    .qv-modal-card { width: 92%; padding: 15px; }
  }
</style>

<script>
  // استبدل الجزء الخاص برسم الألوان (colorHTML) داخل renderModalData بهذا الكود فقط:

let colorHTML = '';
const colorOpt = product.options.find(o => o.name.toLowerCase().includes('color'));

// خريطة شاملة لتحويل اسم أي لون من Shopify لـ Hex مطابق
const colorHexMap = {
  'blue': '#0D499F',
  'black': '#000000',
  'white': '#FFFFFF',
  'red': '#DC2626',
  'grey': '#6B7280',
  'gray': '#6B7280',
  'green': '#15803D'
};

if (colorOpt && colorOpt.values.length > 0) {
  selectedColor = colorOpt.values[0];
  colorHTML += `<label class="qv-label">${colorOpt.name}</label><div class="qv-swatch-wrapper">`;
  
  colorOpt.values.forEach((val, idx) => {
    const cleanVal = val.toLowerCase().trim();
    // يقرأ اللون الخاص بالمنتج، ولو أزرق يأخذ #0D499F
    const hexColor = colorHexMap[cleanVal] || cleanVal;

    colorHTML += `
      <button type="button" 
              class="qv-swatch-btn ${idx === 0 ? 'active' : ''}" 
              style="--swatch-color: ${hexColor};" 
              data-value="${val}">
        ${val}
      </button>`;
  });
  colorHTML += `</div>`;
}
</script>

{% schema %}
{
  "name": "Custom Product Grid",
  "settings": [],
  "blocks": [
    {
      "type": "product_block",
      "name": "Product",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Select Product"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Custom Product Grid",
      "blocks": [
        { "type": "product_block" },
        { "type": "product_block" },
        { "type": "product_block" }
      ]
    }
  ]
}
{% endschema %}