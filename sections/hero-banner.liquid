<div class="hero-master-container">
  
  <!-- Frame 1956: Top Bar -->
  <div class="figma-frame-1956">
    <div class="brand-logo">{{ section.settings.logo_text }}</div>
    <div class="top-center-text">{{ section.settings.top_center_text }}</div>
    <a href="{{ section.settings.yellow_btn_link }}" class="yellow-btn-animated">
      <span>{{ section.settings.yellow_btn_text }}</span>
      <span class="btn-arrow">&rarr;</span>
    </a>
  </div>

  <!-- Group 1000007949: Middle Main Hero Section -->
  <div class="figma-group-hero" style="background-image: url('{{ section.settings.bg_image | image_url: width: 3840 }}');">
    <div class="figma-content-locked">
      <h1 class="hero-main-title">{{ section.settings.main_title }}</h1>
      <p class="hero-description">{{ section.settings.description_text }}</p>
      <a href="{{ section.settings.shop_btn_link }}" class="black-btn-animated">
        <span>{{ section.settings.shop_btn_text }}</span>
        <span class="btn-arrow">&rarr;</span>
      </a>
    </div>
  </div>

  <!-- Frame 1957: Bottom Bar -->
  <div class="figma-frame-1957">
    <span>{{ section.settings.bottom_footer_text }}</span>
  </div>

</div>

<style>
  .hero-master-container {
    width: 100%;
    max-width: 3840px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    box-sizing: border-box;
    background: #ffffff;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  }

  /* Frame 1956 CSS (Mapped from 3840px canvas) */
  .figma-frame-1956 {
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding: 0.7vw 3.47vw; /* 26.66px & 133.33px relative to 3840px */
    height: 4.44vw; /* 170.67px relative to 3840px */
    background: #F5F5F5;
    box-sizing: border-box;
  }

  .brand-logo {
    font-size: clamp(14px, 1.2vw, 36px);
    font-weight: 800;
    color: #000000;
    letter-spacing: 1.2px;
  }

  .top-center-text {
    font-size: clamp(10px, 0.85vw, 22px);
    color: #333333;
  }

  .yellow-btn-animated {
    background-color: #FFF200;
    color: #000000;
    padding: 0.6vw 1.2vw;
    font-size: clamp(10px, 0.8vw, 20px);
    font-weight: 700;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  /* Group 1000007949 CSS (Mapped 3840x2080) */
  .figma-group-hero {
    position: relative;
    width: 100%;
    padding-top: 54.166% !important; /* Aspect Ratio 2080/3840 */
    background-size: 100% 100% !important;
    background-position: center !important;
    background-repeat: no-repeat !important;
  }



/* توسيع حاوية النص لتسمح بفرد الجملة على سطر واحد */
.figma-content-locked {
  position: absolute;
  top: 52%; 
  left: 3.47vw; 
  width: 38vw !important; /* زوّدنا العرض عشان الجملة تفرش وما تتخنقش */
  max-width: 600px;
  z-index: 5;
}

/* إجبار العنوان إنه يفضل على سطر واحد تماماً */
.hero-main-title {
  font-size: clamp(22px, 3.2vw, 95px); /* ضبط الخط ليتناسب مع العرض */
  font-weight: 700;
  color: #000000 !important;
  line-height: 1.0;
  margin: 0 0 1vw 0;
  letter-spacing: -1px;
  white-space: nowrap !important; /* تمنع الكلمة تنزل سطر جديد نهائياً */
}

  .hero-description {
    font-size: clamp(11px, 1.05vw, 28px);
    color: #222222 !important;
    line-height: 1.4;
    margin-bottom: 1.8vw;
  }

  .black-btn-animated {
    background-color: #000000;
    color: #ffffff;
    padding: 0.8vw 1.6vw;
    font-size: clamp(10px, 0.85vw, 22px);
    font-weight: 700;
    text-decoration: none;
    display: inline-flex;
    justify-content: space-between;
    align-items: center;
    min-width: 120px;
  }

  /* Frame 1957 CSS (Mapped from 3840px canvas) */
  .figma-frame-1957 {
    display: flex;
    flex-direction: row;
    justify-content: center;
    align-items: center;
    padding: 0.7vw 3.47vw; /* 26.66px & 133.33px relative to 3840px */
    height: 2.32vw; /* 89.33px relative to 3840px */
    background: #F5F5F5;
    box-sizing: border-box;
    font-size: clamp(9px, 0.75vw, 20px);
    color: #222222;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }
</style>

{% schema %}
{
  "name": "Custom Hero Banner",
  "settings": [
    { "type": "image_picker", "id": "bg_image", "label": "Background Image" },
    { "type": "text", "id": "logo_text", "label": "Logo", "default": "TISSO VISON" },
    { "type": "text", "id": "top_center_text", "label": "Top Text", "default": "Find the ideal gift for your loved ones." },
    { "type": "text", "id": "yellow_btn_text", "label": "Yellow Btn", "default": "CHOOSE GIFT" },
    { "type": "url", "id": "yellow_btn_link", "label": "Yellow Link" },
    { "type": "text", "id": "main_title", "label": "Title", "default": "The Gift Guide" },
    { "type": "textarea", "id": "description_text", "label": "Desc", "default": "Discover Joy: Your Ultimate Holiday Gift Destination. Explore our curated selection and find the perfect gifts to delight your loved ones this holiday season." },
    { "type": "text", "id": "shop_btn_text", "label": "Shop Btn", "default": "SHOP NOW" },
    { "type": "url", "id": "shop_btn_link", "label": "Shop Link" },
    { "type": "text", "id": "bottom_footer_text", "label": "Footer Text", "default": "SUSTAINABLE, ETHICALLY MADE CLOTHES IN SIZES XXS TO 6XL." }
  ],
  "presets": [{ "name": "Custom Hero Banner" }]
}
{% endschema %}