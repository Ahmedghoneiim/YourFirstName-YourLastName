<div class="custom-hero-banner" style="background-image: url('{{ section.settings.bg_image | image_url: width: 2000 }}');">
  
  <!-- Top Bar -->
  <div class="banner-top-bar">
    <div class="brand-logo">{{ section.settings.logo_text }}</div>
    <div class="top-center-text">{{ section.settings.top_center_text }}</div>
    <a href="{{ section.settings.yellow_btn_link }}" class="yellow-btn-animated">
      <span>{{ section.settings.yellow_btn_text }}</span>
      <span class="btn-arrow">&rarr;</span>
    </a>
  </div>

  <!-- Hero Content -->
  <div class="banner-content-box">
    <h1 class="hero-main-title">{{ section.settings.main_title }}</h1>
    <p class="hero-description">{{ section.settings.description_text }}</p>
    <a href="{{ section.settings.shop_btn_link }}" class="black-btn-animated">
      <span>{{ section.settings.shop_btn_text }}</span>
      <span class="btn-arrow">&rarr;</span>
    </a>
  </div>

  <!-- Bottom Bar -->
  <div class="banner-bottom-bar">
    <span>{{ section.settings.bottom_footer_text }}</span>
  </div>

</div>

<style>
  .custom-hero-banner {
    position: relative;
    width: 100%;
    min-height: 85vh;
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 20px 30px;
    box-sizing: border-box;
    font-family: sans-serif;
  }

  /* Top Bar Header */
  .banner-top-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    width: 100%;
  }

  .brand-logo {
    font-size: 16px;
    font-weight: bold;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: #000;
  }

  .top-center-text {
    font-size: 11px;
    color: #333;
    letter-spacing: 0.5px;
  }

  /* Yellow Animated Button */
  .yellow-btn-animated {
    background-color: #FFF200;
    color: #000;
    padding: 8px 16px;
    text-decoration: none;
    font-size: 11px;
    font-weight: bold;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    border-radius: 0px;
    transition: all 0.3s ease;
  }

  .yellow-btn-animated:hover {
    background-color: #e6d800;
    transform: translateY(-2px);
  }

  .yellow-btn-animated:hover .btn-arrow {
    transform: translateX(4px);
  }

  /* Main Hero Box Left */
  .banner-content-box {
    max-width: 320px;
    margin-top: auto;
    margin-bottom: auto;
    padding-left: 10px;
  }

  .hero-main-title {
    font-size: 42px;
    font-weight: normal;
    margin: 0 0 12px 0;
    color: #000;
    line-height: 1.1;
    font-family: serif;
  }

  .hero-description {
    font-size: 11px;
    color: #444;
    line-height: 1.4;
    margin-bottom: 20px;
  }

  /* Black Animated Button */
  .black-btn-animated {
    background-color: #000;
    color: #fff;
    padding: 10px 20px;
    text-decoration: none;
    font-size: 11px;
    font-weight: bold;
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    min-width: 130px;
    letter-spacing: 1px;
    transition: all 0.3s ease;
  }

  .black-btn-animated:hover {
    background-color: #222;
    transform: translateY(-2px);
  }

  .black-btn-animated:hover .btn-arrow {
    transform: translateX(4px);
  }

  .btn-arrow {
    transition: transform 0.3s ease;
  }

  /* Bottom Bar */
  .banner-bottom-bar {
    text-align: center;
    font-size: 9px;
    letter-spacing: 1px;
    color: #333;
    text-transform: uppercase;
    width: 100%;
  }

  @media (max-width: 768px) {
    .custom-hero-banner { padding: 15px; }
    .top-center-text { display: none; }
    .hero-main-title { font-size: 32px; }
  }
</style>

{% schema %}
{
  "name": "Custom Hero Banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background Image"
    },
    {
      "type": "text",
      "id": "logo_text",
      "label": "Brand Logo Text",
      "default": "TISSO VISON"
    },
    {
      "type": "text",
      "id": "top_center_text",
      "label": "Top Center Banner Text",
      "default": "Find the ideal gift for your loved ones."
    },
    {
      "type": "text",
      "id": "yellow_btn_text",
      "label": "Yellow Button Text",
      "default": "CHOOSE GIFT"
    },
    {
      "type": "url",
      "id": "yellow_btn_link",
      "label": "Yellow Button Link"
    },
    {
      "type": "text",
      "id": "main_title",
      "label": "Main Heading Title",
      "default": "The Gift Guide"
    },
    {
      "type": "textarea",
      "id": "description_text",
      "label": "Description Text",
      "default": "Discover Joy: Your Ultimate Holiday Gift Destination. Explore our curated selection and find the perfect gifts to delight your loved ones this holiday season."
    },
    {
      "type": "text",
      "id": "shop_btn_text",
      "label": "Shop Button Text",
      "default": "SHOP NOW"
    },
    {
      "type": "url",
      "id": "shop_btn_link",
      "label": "Shop Button Link"
    },
    {
      "type": "text",
      "id": "bottom_footer_text",
      "label": "Bottom Footer Text",
      "default": "SUSTAINABLE, ETHICALLY MADE CLOTHES IN SIZES XXS TO 6XL."
    }
  ],
  "presets": [
    {
      "name": "Custom Hero Banner"
    }
  ]
}
{% endschema %}