<div class="hero-master-container">
  
  <div class="figma-frame-1956">
    <div class="mobile-menu-icon">
      <span></span>
      <span></span>
      <span></span>
    </div>
    <div class="brand-logo">{{ section.settings.logo_text }}</div>
    <div class="top-center-text">{{ section.settings.top_center_text }}</div>
    <a href="{{ section.settings.yellow_btn_link }}" class="yellow-btn-animated">
      <span>{{ section.settings.yellow_btn_text }}</span>
      <span class="btn-arrow">&rarr;</span>
    </a>
  </div>

  <div class="figma-group-hero">
    <!-- Desktop Image -->
    <img 
      src="{{ section.settings.bg_image | image_url: width: 3840 }}" 
      alt="Hero Desktop Graphics" 
      class="hero-absolute-img desktop-only-img"
    >

    <!-- Mobile Image (Fallback to desktop image if mobile image is not uploaded) -->
    {% assign mobile_img = section.settings.bg_image_mobile | default: section.settings.bg_image %}
    <img 
      src="{{ mobile_img | image_url: width: 800 }}" 
      alt="Hero Mobile Graphics" 
      class="hero-absolute-img mobile-only-img"
    >

    <div class="figma-content-locked">
      <h1 class="hero-main-title">{{ section.settings.main_title }}</h1>
      <p class="hero-description">{{ section.settings.description_text }}</p>
      <a href="{{ section.settings.shop_btn_link }}" class="black-btn-animated">
        <span>{{ section.settings.shop_btn_text }}</span>
        <span class="btn-arrow">&rarr;</span>
      </a>
    </div>
  </div>

  <div class="figma-frame-1957">
    <span>{{ section.settings.bottom_footer_text }}</span>
  </div>

</div>

<style>
  .hero-master-container {
    width: 100%;
    max-width: 3840px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    box-sizing: border-box;
    background: #ffffff;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  }

  .figma-frame-1956 {
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding: 0.7vw 3.47vw;
    height: 4.44vw;
    min-height: 50px;
    background: #F5F5F5;
    box-sizing: border-box;
    position: relative;
    z-index: 10;
  }

  .mobile-menu-icon {
    display: none;
    flex-direction: column;
    gap: 4px;
    cursor: pointer;
    width: 20px;
  }

  .mobile-menu-icon span {
    display: block;
    width: 100%;
    height: 2px;
    background-color: #000000;
  }

  .brand-logo {
    font-size: clamp(14px, 1.2vw, 36px);
    font-weight: 800;
    color: #000000;
    letter-spacing: 1.2px;
  }

  .top-center-text {
    font-size: clamp(10px, 0.85vw, 22px);
    color: #333333;
  }

  .yellow-btn-animated {
    background-color: #FFF200;
    color: #000000;
    padding: 0.6vw 1.2vw;
    font-size: clamp(10px, 0.8vw, 20px);
    font-weight: 700;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    white-space: nowrap;
  }

  .figma-group-hero {
    position: relative;
    width: 100%;
    padding-top: 54.166%;
    overflow: hidden;
  }

  .hero-absolute-img {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: fill;
    z-index: 1;
  }

  /* Visibility Controls for Dual Images */
  .mobile-only-img {
    display: none;
  }
  .desktop-only-img {
    display: block;
  }

  .figma-content-locked {
    position: absolute;
    top: 54%; 
    left: 9.80vw; 
    width: 30vw !important;
    max-width: 600px;
    z-index: 5;
  }

  .hero-main-title {
    font-size: clamp(22px, 3.2vw, 95px);
    font-weight: 700;
    color: #000000 !important;
    line-height: 1.0;
    margin: 0 0 1vw 0;
    letter-spacing: -1px;
    white-space: nowrap !important;
  }

  .hero-description {
    font-size: 14px;
    line-height: 1.35;
    max-width: 300px;
    margin: 0 auto;
  }
  .hero-description::before {
    content: "Discover Joy: Your Ultimate Holiday Gift Destination.";
    display: block;
  }
  .black-btn-animated {
    background-color: #000000;
    color: #ffffff;
    padding: 0.8vw 1.6vw;
    font-size: clamp(10px, 0.85vw, 22px);
    font-weight: 700;
    text-decoration: none;
    display: inline-flex;
    justify-content: space-between;
    align-items: center;
    min-width: 120px;
    white-space: nowrap;
  }

  .figma-frame-1957 {
    display: flex;
    flex-direction: row;
    justify-content: center;
    align-items: center;
    padding: 0.7vw 3.47vw;
    height: 2.32vw;
    min-height: 35px;
    background: #F5F5F5;
    box-sizing: border-box;
    font-size: clamp(9px, 0.75vw, 20px);
    color: #222222;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    position: relative;
    z-index: 10;
  }

  /* Mobile Custom Image Settings */
  @media screen and (max-width: 768px) {
    .desktop-only-img {
      display: none !important;
    }

    .mobile-only-img {
      display: block !important;
      position: absolute;
      width: 100%; /* تقدر تكبر النسبة دي زي ما تحب لتعديل أبعاد صورة الموبايل */
      max-width: none !important;
      height: auto;
      top: 37.29%;
      left: 50%;
      transform: translateX(-50%);
      z-index: 1;
    }

    .figma-frame-1956 {
      padding: 12px 20px;
      height: 50px;
      justify-content: flex-start;
    }

    .mobile-menu-icon {
      display: flex;
      position: absolute;
      left: 20px;
    }

    .brand-logo {
      font-size: 18px;
      margin: 0 auto;
      letter-spacing: 1px;
    }

    .top-center-text,
    .yellow-btn-animated {
      display: none !important;
    }

    .figma-group-hero {
      padding-top: 0 !important;
      height: 520px;
      position: relative;
    }

    .figma-content-locked {
      position: absolute;
      top: 30px;
      left: 0;
      width: 100% !important;
      max-width: 100%;
      padding: 0 20px;
      box-sizing: border-box;
      text-align: center;
      display: flex;
      flex-direction: column;
      align-items: center;
      z-index: 5;
    }

    .hero-main-title {
      font-size: 32px;
      white-space: nowrap !important;
      margin-bottom: 10px;
      letter-spacing: -0.5px;
    }

    .hero-description {
      font-size: 14px;
      line-height: 1.35;
      max-width: 300px;
      margin: 0 auto;
    }

    .black-btn-animated {
      position: absolute;
      top: 390px;
      left: 50%;
      transform: translateX(-50%);
      padding: 12px 24px;
      font-size: 11px;
      width: 170px;
      box-sizing: border-box;
      z-index: 6;
    }

    .figma-frame-1957 {
      padding: 12px 10px;
      height: auto;
      font-size: 10px;
      text-align: center;
    }
  }
</style>

{% schema %}
{
  "name": "Custom Hero Banner",
  "settings": [
    { "type": "image_picker", "id": "bg_image", "label": "Desktop Image" },
    { "type": "image_picker", "id": "bg_image_mobile", "label": "Mobile Image (Optional)" },
    { "type": "text", "id": "logo_text", "label": "Logo", "default": "TISSO VISON" },
    { "type": "text", "id": "top_center_text", "label": "Top Text", "default": "Find the ideal gift for your loved ones." },
    { "type": "text", "id": "yellow_btn_text", "label": "Yellow Btn", "default": "CHOOSE GIFT" },
    { "type": "url", "id": "yellow_btn_link", "label": "Yellow Link" },
    { "type": "text", "id": "main_title", "label": "Title", "default": "The Gift Guide" },
    { "type": "textarea", "id": "description_text", "label": "Desc", "default": "Discover Joy: Your Ultimate Holiday Gift Destination. Explore our curated selection and find the perfect gifts to delight your loved ones this holiday season." },
    { "type": "text", "id": "shop_btn_text", "label": "Shop Btn", "default": "SHOP NOW" },
    { "type": "url", "id": "shop_btn_link", "label": "Shop Link" },
    { "type": "text", "id": "bottom_footer_text", "label": "Footer Text", "default": "SUSTAINABLE, ETHICALLY MADE CLOTHES IN SIZES XXS TO 6XL." }
  ],
  "presets": [{ "name": "Custom Hero Banner" }]
}
{% endschema %}