<div class="custom-hero-banner" style="background-image: url('{{ section.settings.bg_image | image_url: width: 2000 }}');">
  
  <!-- Top Bar -->
  <div class="banner-top-bar">
    <div class="brand-logo">{{ section.settings.logo_text }}</div>
    <div class="top-center-text">{{ section.settings.top_center_text }}</div>
    <a href="{{ section.settings.yellow_btn_link }}" class="yellow-btn-animated">
      <span>{{ section.settings.yellow_btn_text }}</span>
      <span class="btn-arrow">&rarr;</span>
    </a>
  </div>

  <!-- Hero Content Box -->
  <div class="banner-content-box">
    <h1 class="hero-main-title">{{ section.settings.main_title }}</h1>
    <p class="hero-description">{{ section.settings.description_text }}</p>
    <a href="{{ section.settings.shop_btn_link }}" class="black-btn-animated">
      <span>{{ section.settings.shop_btn_text }}</span>
      <span class="btn-arrow">&rarr;</span>
    </a>
  </div>

  <!-- Bottom Bar -->
  <div class="banner-bottom-bar">
    <span>{{ section.settings.bottom_footer_text }}</span>
  </div>

</div>

<style>
  .custom-hero-banner {
    position: relative;
    width: 100%;
    min-height: 85vh;
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    
    /* عكس ألوان الصورة السوداء لتصبح خطوط سوداء على خلفية بيضاء */
    filter: invert(1);
    
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 30px 40px;
    box-sizing: border-box;
    font-family: sans-serif;
  }

  /* Top Bar */
  .banner-top-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    width: 100%;
    z-index: 2;
  }

  .brand-logo {
    font-size: 16px;
    font-weight: bold;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: #fff; /* محكوسة بسبب الفلتر فبتطلع أسود */
  }

  .top-center-text {
    font-size: 11px;
    color: #333;
    letter-spacing: 0.5px;
  }

  .yellow-btn-animated {
    background-color: #000dff; /* عكس لون الأصفر بالفلتر ليظهر أصفر أصلي */
    color: #fff;
    padding: 10px 20px;
    text-decoration: none;
    font-size: 11px;
    font-weight: bold;
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  /* Hero Content Box Positioning */
  .banner-content-box {
    max-width: 320px;
    margin-top: auto;
    margin-bottom: auto;
    margin-left: 5%;
    padding: 20px;
    background: rgba(0, 0, 0, 0.65); /* مفرغ ومظبوط للخط */
    z-index: 2;
  }

  .hero-main-title {
    font-size: 42px;
    font-weight: normal;
    margin: 0 0 12px 0;
    color: #fff;
    line-height: 1.1;
    font-family: serif;
  }

  .hero-description {
    font-size: 11px;
    color: #ddd;
    line-height: 1.4;
    margin-bottom: 20px;
  }

  .black-btn-animated {
    background-color: #fff;
    color: #000;
    padding: 10px 20px;
    text-decoration: none;
    font-size: 11px;
    font-weight: bold;
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    min-width: 130px;
    letter-spacing: 1px;
  }

  /* Bottom Bar */
  .banner-bottom-bar {
    text-align: center;
    font-size: 9px;
    letter-spacing: 1px;
    color: #222;
    text-transform: uppercase;
    width: 100%;
    z-index: 2;
  }
</style>

{% schema %}
{
  "name": "Custom Hero Banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background Image"
    },
    {
      "type": "text",
      "id": "logo_text",
      "label": "Brand Logo Text",
      "default": "TISSO VISON"
    },
    {
      "type": "text",
      "id": "top_center_text",
      "label": "Top Center Banner Text",
      "default": "Find the ideal gift for your loved ones."
    },
    {
      "type": "text",
      "id": "yellow_btn_text",
      "label": "Yellow Button Text",
      "default": "CHOOSE GIFT"
    },
    {
      "type": "url",
      "id": "yellow_btn_link",
      "label": "Yellow Button Link"
    },
    {
      "type": "text",
      "id": "main_title",
      "label": "Main Heading Title",
      "default": "The Gift Guide"
    },
    {
      "type": "textarea",
      "id": "description_text",
      "label": "Description Text",
      "default": "Discover Joy: Your Ultimate Holiday Gift Destination. Explore our curated selection and find the perfect gifts to delight your loved ones this holiday season."
    },
    {
      "type": "text",
      "id": "shop_btn_text",
      "label": "Shop Button Text",
      "default": "SHOP NOW"
    },
    {
      "type": "url",
      "id": "shop_btn_link",
      "label": "Shop Button Link"
    },
    {
      "type": "text",
      "id": "bottom_footer_text",
      "label": "Bottom Footer Text",
      "default": "SUSTAINABLE, ETHICALLY MADE CLOTHES IN SIZES XXS TO 6XL."
    }
  ],
  "presets": [
    {
      "name": "Custom Hero Banner"
    }
  ]
}
{% endschema %}