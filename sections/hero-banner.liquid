<div class="custom-hero-banner" style="background-image: url('{{ section.settings.bg_image | image_url: width: 2000 }}');">
  
  <!-- Top Bar -->
  <div class="banner-top-bar">
    <div class="brand-logo">{{ section.settings.logo_text }}</div>
    <div class="top-center-text">{{ section.settings.top_center_text }}</div>
    <a href="{{ section.settings.yellow_btn_link }}" class="yellow-btn-animated">
      <span>{{ section.settings.yellow_btn_text }}</span>
      <span class="btn-arrow">&rarr;</span>
    </a>
  </div>

  <!-- Content Positioned Exactly Like Figma Design -->
  <div class="banner-content-box">
    <h1 class="hero-main-title">{{ section.settings.main_title }}</h1>
    <p class="hero-description">{{ section.settings.description_text }}</p>
    <a href="{{ section.settings.shop_btn_link }}" class="black-btn-animated">
      <span>{{ section.settings.shop_btn_text }}</span>
      <span class="btn-arrow">&rarr;</span>
    </a>
  </div>

  <!-- Bottom Bar -->
  <div class="banner-bottom-bar">
    <span>{{ section.settings.bottom_footer_text }}</span>
  </div>

</div>

<style>
  .custom-hero-banner {
    position: relative;
    width: 100%;
    aspect-ratio: 1920 / 1080; /* نفس نسبة أبعاد شاشة الديسكتوب للتصميم */
    min-height: 650px;
    background-size: 100% 100% !important; /* احتواء الصورة كاملة بدون زووم أو قص */
    background-position: center !important;
    background-repeat: no-repeat !important;
    background-color: #ffffff !important;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 24px 40px 12px 40px;
    box-sizing: border-box;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
  }

  /* Top Bar Header */
  .banner-top-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    width: 100%;
    z-index: 5;
  }

  .brand-logo {
    font-size: 15px;
    font-weight: 700;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: #000000;
  }

  .top-center-text {
    font-size: 12px;
    color: #222222;
    letter-spacing: 0.2px;
  }

  .yellow-btn-animated {
    background-color: #FFF200;
    color: #000000;
    padding: 10px 18px;
    text-decoration: none;
    font-size: 11px;
    font-weight: 700;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    letter-spacing: 0.5px;
    transition: background-color 0.2s ease;
  }

  .yellow-btn-animated:hover {
    background-color: #e5d900;
  }

  /* Main Hero Content - Positioned Perfectly Over White Gap */
  .banner-content-box {
    position: absolute;
    top: 52%; /* ضبط الارتفاع ليكون في المساحة البيضاء الفاضية تماماً */
    left: 40px;
    transform: translateY(-50%);
    max-width: 380px;
    z-index: 5;
  }

  .hero-main-title {
    font-size: 52px;
    font-weight: 500;
    margin: 0 0 16px 0;
    color: #000000;
    line-height: 1.0;
    letter-spacing: -0.5px;
    font-family: inherit;
  }

  .hero-description {
    font-size: 12px;
    color: #333333;
    line-height: 1.45;
    margin-bottom: 28px;
    max-width: 340px;
  }

  .black-btn-animated {
    background-color: #000000;
    color: #ffffff;
    padding: 12px 24px;
    text-decoration: none;
    font-size: 11px;
    font-weight: 600;
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    min-width: 130px;
    letter-spacing: 1px;
    transition: opacity 0.2s ease;
  }

  .black-btn-animated:hover {
    opacity: 0.85;
  }

  .btn-arrow {
    margin-left: 15px;
  }

  /* Bottom Bar Footer */
  .banner-bottom-bar {
    text-align: center;
    font-size: 10px;
    letter-spacing: 0.8px;
    color: #222222;
    text-transform: uppercase;
    width: 100%;
    z-index: 5;
  }

  @media (max-width: 1024px) {
    .banner-content-box {
      top: 50%;
      left: 30px;
    }
    .hero-main-title {
      font-size: 38px;
    }
  }
</style>

{% schema %}
{
  "name": "Custom Hero Banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background Image"
    },
    {
      "type": "text",
      "id": "logo_text",
      "label": "Brand Logo Text",
      "default": "TISSO VISON"
    },
    {
      "type": "text",
      "id": "top_center_text",
      "label": "Top Center Banner Text",
      "default": "Find the ideal gift for your loved ones."
    },
    {
      "type": "text",
      "id": "yellow_btn_text",
      "label": "Yellow Button Text",
      "default": "CHOOSE GIFT"
    },
    {
      "type": "url",
      "id": "yellow_btn_link",
      "label": "Yellow Button Link"
    },
    {
      "type": "text",
      "id": "main_title",
      "label": "Main Heading Title",
      "default": "The Gift Guide"
    },
    {
      "type": "textarea",
      "id": "description_text",
      "label": "Description Text",
      "default": "Discover Joy: Your Ultimate Holiday Gift Destination. Explore our curated selection and find the perfect gifts to delight your loved ones this holiday season."
    },
    {
      "type": "text",
      "id": "shop_btn_text",
      "label": "Shop Button Text",
      "default": "SHOP NOW"
    },
    {
      "type": "url",
      "id": "shop_btn_link",
      "label": "Shop Button Link"
    },
    {
      "type": "text",
      "id": "bottom_footer_text",
      "label": "Bottom Footer Text",
      "default": "SUSTAINABLE, ETHICALLY MADE CLOTHES IN SIZES XXS TO 6XL."
    }
  ],
  "presets": [
    {
      "name": "Custom Hero Banner"
    }
  ]
}
{% endschema %}