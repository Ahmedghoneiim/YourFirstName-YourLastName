<div class="custom-hero-banner" style="background-image: url('{{ section.settings.bg_image | image_url: width: 2000 }}');">
  
  <!-- Top Bar -->
  <div class="banner-top-bar">
    <div class="brand-logo">{{ section.settings.logo_text }}</div>
    <div class="top-center-text">{{ section.settings.top_center_text }}</div>
    <a href="{{ section.settings.yellow_btn_link }}" class="yellow-btn-animated">
      <span>{{ section.settings.yellow_btn_text }}</span>
      <span class="btn-arrow">&rarr;</span>
    </a>
  </div>

  <!-- Content Box Positioned Exactly Under The Camera Frame -->
  <div class="banner-content-box">
    <h1 class="hero-main-title">{{ section.settings.main_title }}</h1>
    <p class="hero-description">{{ section.settings.description_text }}</p>
    <a href="{{ section.settings.shop_btn_link }}" class="black-btn-animated">
      <span>{{ section.settings.shop_btn_text }}</span>
      <span class="btn-arrow">&rarr;</span>
    </a>
  </div>

  <!-- Bottom Bar -->
  <div class="banner-bottom-bar">
    <span>{{ section.settings.bottom_footer_text }}</span>
  </div>

</div>

<style>
  .custom-hero-banner {
    position: relative;
    width: 100%;
    height: 90vh;
    min-height: 620px;
    background-size: cover !important;
    background-position: center center !important;
    background-repeat: no-repeat !important;
    background-color: #ffffff !important;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 24px 40px;
    box-sizing: border-box;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  }

  /* Header Bar */
  .banner-top-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    width: 100%;
    z-index: 10;
  }

  .brand-logo {
    font-size: 16px;
    font-weight: 800;
    letter-spacing: 1.2px;
    color: #000000;
  }

  .top-center-text {
    font-size: 11px;
    color: #333333;
  }

  .yellow-btn-animated {
    background-color: #FFF200;
    color: #000000;
    padding: 10px 20px;
    text-decoration: none;
    font-size: 11px;
    font-weight: 700;
    display: inline-flex;
    align-items: center;
    gap: 10px;
  }

  /* Exact Content Positioning */
  .banner-content-box {
    position: absolute;
    top: 56%;
    left: 4.5%;
    transform: translateY(-50%);
    max-width: 360px;
    z-index: 10;
    background: transparent !important;
  }

  .hero-main-title {
    font-size: 54px;
    font-weight: 600;
    margin: 0 0 16px 0;
    color: #000000 !important;
    line-height: 1.0;
    letter-spacing: -1px;
  }

  .hero-description {
    font-size: 12px;
    color: #111111 !important;
    line-height: 1.45;
    margin-bottom: 28px;
    max-width: 330px;
  }

  .black-btn-animated {
    background-color: #000000;
    color: #ffffff;
    padding: 12px 22px;
    text-decoration: none;
    font-size: 11px;
    font-weight: 700;
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    width: 135px;
    letter-spacing: 0.5px;
  }

  /* Footer Text */
  .banner-bottom-bar {
    text-align: center;
    font-size: 10px;
    letter-spacing: 0.8px;
    color: #222222;
    text-transform: uppercase;
    width: 100%;
    z-index: 10;
  }
</style>

{% schema %}
{
  "name": "Custom Hero Banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background Image"
    },
    {
      "type": "text",
      "id": "logo_text",
      "label": "Brand Logo Text",
      "default": "TISSO VISON"
    },
    {
      "type": "text",
      "id": "top_center_text",
      "label": "Top Center Banner Text",
      "default": "Find the ideal gift for your loved ones."
    },
    {
      "type": "text",
      "id": "yellow_btn_text",
      "label": "Yellow Button Text",
      "default": "CHOOSE GIFT"
    },
    {
      "type": "url",
      "id": "yellow_btn_link",
      "label": "Yellow Button Link"
    },
    {
      "type": "text",
      "id": "main_title",
      "label": "Main Heading Title",
      "default": "The Gift Guide"
    },
    {
      "type": "textarea",
      "id": "description_text",
      "label": "Description Text",
      "default": "Discover Joy: Your Ultimate Holiday Gift Destination. Explore our curated selection and find the perfect gifts to delight your loved ones this holiday season."
    },
    {
      "type": "text",
      "id": "shop_btn_text",
      "label": "Shop Button Text",
      "default": "SHOP NOW"
    },
    {
      "type": "url",
      "id": "shop_btn_link",
      "label": "Shop Button Link"
    },
    {
      "type": "text",
      "id": "bottom_footer_text",
      "label": "Bottom Footer Text",
      "default": "SUSTAINABLE, ETHICALLY MADE CLOTHES IN SIZES XXS TO 6XL."
    }
  ],
  "presets": [
    {
      "name": "Custom Hero Banner"
    }
  ]
}
{% endschema %}