<div class="hero-master-container">
  
  <div class="figma-frame-1956">
    <div class="brand-logo">{{ section.settings.logo_text }}</div>
    <div class="top-center-text">{{ section.settings.top_center_text }}</div>
    <a href="{{ section.settings.yellow_btn_link }}" class="yellow-btn-animated">
      <span>{{ section.settings.yellow_btn_text }}</span>
      <span class="btn-arrow">&rarr;</span>
    </a>
  </div>

  <div class="figma-group-hero" style="background-image: url('{{ section.settings.bg_image | image_url: width: 3840 }}');">
    <div class="figma-content-locked">
      <h1 class="hero-main-title">{{ section.settings.main_title }}</h1>
      <p class="hero-description">{{ section.settings.description_text }}</p>
      <a href="{{ section.settings.shop_btn_link }}" class="black-btn-animated">
        <span>{{ section.settings.shop_btn_text }}</span>
        <span class="btn-arrow">&rarr;</span>
      </a>
    </div>
  </div>

  <div class="figma-frame-1957">
    <span>{{ section.settings.bottom_footer_text }}</span>
  </div>

</div>

<style>
  .hero-master-container {
    width: 100%;
    max-width: 3840px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    box-sizing: border-box;
    background: #ffffff;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  }

  .figma-frame-1956 {
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding: 0.7vw 3.47vw;
    height: 4.44vw;
    min-height: 50px;
    background: #F5F5F5;
    box-sizing: border-box;
  }

  .brand-logo {
    font-size: clamp(14px, 1.2vw, 36px);
    font-weight: 800;
    color: #000000;
    letter-spacing: 1.2px;
  }

  .top-center-text {
    font-size: clamp(10px, 0.85vw, 22px);
    color: #333333;
  }

  .yellow-btn-animated {
    background-color: #FFF200;
    color: #000000;
    padding: 0.6vw 1.2vw;
    font-size: clamp(10px, 0.8vw, 20px);
    font-weight: 700;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    white-space: nowrap;
  }

  .figma-group-hero {
    position: relative;
    width: 100%;
    padding-top: 54.166% !important;
    background-size: 100% 100% !important;
    background-position: center !important;
    background-repeat: no-repeat !important;
  }

  .figma-content-locked {
    position: absolute;
    top: 54%; 
    left: 9.80vw; 
    width: 30vw !important;
    max-width: 600px;
    z-index: 5;
  }

  .hero-main-title {
    font-size: clamp(22px, 3.2vw, 95px);
    font-weight: 700;
    color: #000000 !important;
    line-height: 1.0;
    margin: 0 0 1vw 0;
    letter-spacing: -1px;
    white-space: nowrap !important;
  }

  .hero-description {
    font-size: clamp(11px, 1.05vw, 28px);
    color: #222222 !important;
    line-height: 1.4;
    margin-bottom: 1.8vw;
  }

  .black-btn-animated {
    background-color: #000000;
    color: #ffffff;
    padding: 0.8vw 1.6vw;
    font-size: clamp(10px, 0.85vw, 22px);
    font-weight: 700;
    text-decoration: none;
    display: inline-flex;
    justify-content: space-between;
    align-items: center;
    min-width: 120px;
    white-space: nowrap;
  }

  .figma-frame-1957 {
    display: flex;
    flex-direction: row;
    justify-content: center;
    align-items: center;
    padding: 0.7vw 3.47vw;
    height: 2.32vw;
    min-height: 35px;
    background: #F5F5F5;
    box-sizing: border-box;
    font-size: clamp(9px, 0.75vw, 20px);
    color: #222222;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  /* Mobile Responsive Media Queries */
  @media screen and (max-width: 768px) {
    .figma-frame-1956 {
      padding: 12px 16px;
      height: auto;
      gap: 8px;
    }

    .top-center-text {
      display: none;
    }

    .brand-logo {
      font-size: 14px;
    }

    .yellow-btn-animated {
      padding: 6px 12px;
      font-size: 10px;
    }

    .figma-group-hero {
      padding-top: 0 !important;
      min-height: auto;
      background-size: cover !important;
      display: flex;
      flex-direction: column;
    }

    .figma-content-locked {
      position: relative;
      top: 0;
      left: 0;
      width: 100% !important;
      max-width: 100%;
      padding: 30px 20px;
      box-sizing: border-box;
      background: rgba(255, 255, 255, 0.9);
      backdrop-filter: blur(2px);
    }

    .hero-main-title {
      font-size: 28px;
      white-space: normal !important;
      margin-bottom: 12px;
    }

    .hero-description {
      font-size: 13px;
      margin-bottom: 20px;
    }

    .black-btn-animated {
      padding: 10px 18px;
      font-size: 11px;
      width: auto;
      display: inline-flex;
    }

    .figma-frame-1957 {
      padding: 10px 16px;
      height: auto;
      font-size: 9px;
      text-align: center;
    }
  }
</style>

{% schema %}
{
  "name": "Custom Hero Banner",
  "settings": [
    { "type": "image_picker", "id": "bg_image", "label": "Background Image" },
    { "type": "text", "id": "logo_text", "label": "Logo", "default": "TISSO VISON" },
    { "type": "text", "id": "top_center_text", "label": "Top Text", "default": "Find the ideal gift for your loved ones." },
    { "type": "text", "id": "yellow_btn_text", "label": "Yellow Btn", "default": "CHOOSE GIFT" },
    { "type": "url", "id": "yellow_btn_link", "label": "Yellow Link" },
    { "type": "text", "id": "main_title", "label": "Title", "default": "The Gift Guide" },
    { "type": "textarea", "id": "description_text", "label": "Desc", "default": "Discover Joy: Your Ultimate Holiday Gift Destination. Explore our curated selection and find the perfect gifts to delight your loved ones this holiday season." },
    { "type": "text", "id": "shop_btn_text", "label": "Shop Btn", "default": "SHOP NOW" },
    { "type": "url", "id": "shop_btn_link", "label": "Shop Link" },
    { "type": "text", "id": "bottom_footer_text", "label": "Footer Text", "default": "SUSTAINABLE, ETHICALLY MADE CLOTHES IN SIZES XXS TO 6XL." }
  ],
  "presets": [{ "name": "Custom Hero Banner" }]
}
{% endschema %}